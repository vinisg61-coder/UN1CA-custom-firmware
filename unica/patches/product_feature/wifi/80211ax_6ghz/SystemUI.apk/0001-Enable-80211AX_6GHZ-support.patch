Subject: [PATCH] Enable 80211AX_6GHZ support

---
 smali_classes3/com/android/systemui/statusbar/connectivity/AccessPointControllerImpl.smali |    2 +++++++-------
 smali_classes3/com/android/systemui/statusbar/pipeline/wifi/data/repository/prod/WifiRepositoryImpl.smali |    3 +++++---------
 2 files changed, 2 insertions(+), 3 deletions(-)

diff --git a/smali_classes3/com/android/systemui/statusbar/connectivity/AccessPointControllerImpl.smali b/smali_classes3/com/android/systemui/statusbar/connectivity/AccessPointControllerImpl.smali
index aa086b1ed..36bcd3016 100644
--- a/smali_classes3/com/android/systemui/statusbar/connectivity/AccessPointControllerImpl.smali
+++ b/smali_classes3/com/android/systemui/statusbar/connectivity/AccessPointControllerImpl.smali
@@ -16,7 +16,7 @@
 .field public static final ICONS_WIFI6:[[I
 
-.field public static final ICONS_WIFI6E:[[I
+.field public static final ICONS_WIFI6E:[[I
 
 
 # instance fields
 .field public final mCallbacks:Ljava/util/ArrayList;
diff --git a/smali_classes3/com/android/systemui/statusbar/pipeline/wifi/data/repository/prod/WifiRepositoryImpl.smali b/smali_classes3/com/android/systemui/statusbar/pipeline/wifi/data/repository/prod/WifiRepositoryImpl.smali
index a258e3d5f..d75780d3c 100644
--- a/smali_classes3/com/android/systemui/statusbar/pipeline/wifi/data/repository/prod/WifiRepositoryImpl.smali
+++ b/smali_classes3/com/android/systemui/statusbar/pipeline/wifi/data/repository/prod/WifiRepositoryImpl.smali
@@ -804,7 +804,7 @@
 .method public final toWifiNetworkModel(Lcom/android/wifitrackerlib/WifiEntry;)Lcom/android/systemui/statusbar/pipeline/wifi/shared/model/WifiNetworkModel;
-    .locals 12
+    .locals 12
 
     instance-of v0, p1, Lcom/android/wifitrackerlib/MergedCarrierEntry;
 
     const/4 v1, 0x1
 
     return-void
 .end method
 
