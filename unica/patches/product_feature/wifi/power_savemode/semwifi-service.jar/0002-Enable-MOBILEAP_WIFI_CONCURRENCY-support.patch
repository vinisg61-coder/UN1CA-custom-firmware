     invoke-virtual {v2, v3}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z

     move-result v2

     if-eqz v2, :cond_3

     sput-boolean v5, Lcom/samsung/android/server/wifi/ap/SemWifiApChipInfo;->mSupportWifiSharing:Z

